                      "spec": {
                        "editorMode": "code",
                        "expr": "max(\n  label_replace(request_latency_max_milliseconds{source=\"jwt-pizza-service\"}, \"kind\", \"max\", \"\", \"\")\n  or\n  label_replace(\n    sum(increase(request_latency_milliseconds_sum{source=\"jwt-pizza-service\"}[1m]))\n    / sum(increase(request_latency_milliseconds_count{source=\"jwt-pizza-service\"}[1m])),\n    \"kind\", \"avg\", \"\", \"\")\n)",
